# ══════════════════════════════════════════════════════════════
#   Queen MD Bot v3 — Environment Configuration
#   Copy this file to .env and fill in your values.
# ══════════════════════════════════════════════════════════════
#
#  HOW TO PAIR:
#    1. Set TELEGRAM_BOT_TOKEN below
#    2. Set TELEGRAM_ADMIN_IDS to your Telegram user ID
#    3. Run the bot: node src/index.js
#    4. Open your Telegram bot and send: /pair <whatsapp_number>
#    5. Enter the pairing code in WhatsApp → Linked Devices
# ══════════════════════════════════════════════════════════════

# ── Telegram Pairing Bot ───────────────────────────────────────────────────────
# Get a token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your Telegram token

# Your Telegram user ID — only this ID can run /pair, /unpair etc.
# To find your ID: message @userinfobot on Telegram
# For multiple admins: 123456789,987654321
TELEGRAM_ADMIN_IDS=6504529911

# Maximum simultaneous WhatsApp sessions
MAX_SESSIONS=15

# ── Bot Identity ───────────────────────────────────────────────────────────────
BOT_NAME=Queen MD Bot
PREFIX=!

# Your WhatsApp number — this gets owner-only privileges (!setppbot, !update etc)
OWNER_NUMBER=923120754178

# Owner name shown in help menu
OWNER_NAME=fizu

# Credit line shown in help menu
CREATED_BY=TECH

# Bot bio (WhatsApp profile status)
BOT_BIO=👑 Queen MD Bot | !help for commands

# Bot version shown in !botinfo
BOT_VERSION=3.0.0

# URL of an image shown above the !help menu and in welcome messages
BOT_IMAGE_URL=https://i.ibb.co/cKpSW1yb/IMG-20261003-WA0010.jpg

# ── Public / Private Mode ──────────────────────────────────────────────────────
# true  = anyone who messages the bot can use commands (PUBLIC)
# false = only OWNER_NUMBER can use commands (PRIVATE)
# You can also toggle this live via Telegram: /public or /private
BOT_PUBLIC=true

# ── AI Chat ────────────────────────────────────────────────────────────────────
AI_MODEL=gemini
AI_HISTORY_LIMIT=20
# Optional Google Gemini key for prompt-based photo editing. Keep this in the
# Replit Secrets/environment manager; do not paste keys into chat or source.
# GEMINI_API_KEY=
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
# GEMINI_IMAGE_RATIO=1:1

# ── News ───────────────────────────────────────────────────────────────────────
# Free key at: https://gnews.io  (100 req/day free)
NEWS_API_KEY=your_gnews_api_key_here

# ── AI Image Generation ────────────────────────────────────────────────────────
# zonerai = default (free, no key)
# pollinations = free fallback
# openai = DALL-E 3 (requires OPENAI_API_KEY)
IMAGINE_PROVIDER=zonerai
POLLINATIONS_MODEL=flux
POLLINATIONS_WIDTH=1024
POLLINATIONS_HEIGHT=1024
# OPENAI_API_KEY=sk-...

# ── Auto-React ─────────────────────────────────────────────────────────────────
AUTOREACT_PM_ENABLED=true
AUTOREACT_GROUP_ENABLED=false
# AUTOREACT_EMOJIS=❤️,👍,🔥,😂

# Optional downloader API credentials. Store live values in the host's Secrets
# or environment settings, not in the source archive.
BOTCAHX_API_KEY=GMauog6R
GTECH_FB_API_KEY=APIKEY
# Time used in Anti-Delete recovery notices
BOT_TIME_ZONE=Asia/Karachi

# ── Chatbot (AI auto-reply) ────────────────────────────────────────────────────
CHATBOT_PM_ENABLED=true
CHATBOT_GROUP_ENABLED=false
# David Cyril API key for !music, !song, !ai/chatbot, !soundcloud, !flux,
# and !animate. Keep the actual value in the host's Secrets/environment manager.
# Do not commit the real value.
DAVID_API_KEY=Queen md
# TikTok tries V2, V4, V3, then TikWM when a provider returns no video URL.
TIKTOK_API_URL=https://apis.davidcyriltech.my.id/download/tiktokv2

# ── GitHub Update (!update command) ───────────────────────────────────────────
GITHUB_REPO=JO10345/QUEEN-MD-BOT
GITHUB_BRANCH=main
# GITHUB_TOKEN=ghp_xxxxxxxxxxxx

# ── Feature Toggles ────────────────────────────────────────────────────────────
MUSIC_ENABLED=true
YOUTUBE_ENABLED=true
WEATHER_ENABLED=true
AI_ENABLED=true
MOVIE_ENABLED=true
MEDIAFIRE_ENABLED=true
TELESTICKER_ENABLED=true
STICKER_ENABLED=true
TRANSLATE_ENABLED=true
GROUP_ENABLED=true
REMINDER_ENABLED=true
IMAGINE_ENABLED=true
CALC_ENABLED=true
CURRENCY_ENABLED=true
NEWS_ENABLED=true
FUN_ENABLED=true
POLL_ENABLED=true
QUIZ_ENABLED=true
IMAGE_ENABLED=true
CUTE_ENABLED=true
FBDL_ENABLED=true
ALLIN_ENABLED=true
ADULT_ENABLED=true

# ── Web Admin Dashboard ────────────────────────────────────────────────────────
# Port the management API listens on (default 5001 — open this port in your firewall)
MANAGEMENT_PORT=5001

# Secret key to protect the dashboard API — choose any random string
# Enter this same key in the dashboard settings (the ⚙ icon, top-right)
MANAGEMENT_API_KEY=change-this-to-a-random-secret

# ── Debug ──────────────────────────────────────────────────────────────────────
DEBUG=false
